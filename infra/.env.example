# Copy to infra/.env and change the secrets. infra/.env is git-ignored.

# Postgres (one server, one database per system: hrms_db, agent_db, langfuse)
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

REDIS_PORT=6379

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Langfuse (tracing) — generate secrets with: openssl rand -hex 32
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth
LANGFUSE_SALT=change-me-salt
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_ADMIN_EMAIL=admin@nimbustech.local
LANGFUSE_ADMIN_PASSWORD=change-me-admin

# Ollama (only used with --profile local-llm)
OLLAMA_PORT=11434

# App connection strings (used by services from Day 2 onwards)
HRMS_DATABASE_URL=postgresql+psycopg://brain:change-me-local@localhost:5432/hrms_db
AGENT_DATABASE_URL=postgresql+psycopg://brain:change-me-local@localhost:5432/agent_db
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
